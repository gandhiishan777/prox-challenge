{
  "name": "omnipro-220-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Multimodal support agent for the Vulcan OmniPro 220 multiprocess welder, built on the Claude Agent SDK.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ask": "tsx --env-file=.env scripts/ask.ts",
    "eval": "tsx --env-file=.env eval/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/build-runner.mjs",
    "prebuild": "node scripts/build-runner.mjs",
    "build:runner": "node scripts/build-runner.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "dompurify": "^3.2.7",
    "lucide-react": "^0.545.0",
    "mermaid": "^11.12.0",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
