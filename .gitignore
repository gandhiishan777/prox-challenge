# Secrets — NEVER commit
.env
.env.local
.env*.local

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/dist/
next-env.d.ts

# Extraction pipeline intermediates (outputs land in knowledge/, which IS committed)
build/
__pycache__/
*.pyc
.venv/
venv/

# Eval run outputs
eval/results/

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Built artifact runner bundle (regenerated by predev/prebuild)
public/runner/runner.js

# TypeScript incremental cache — dirties the tree on every tsc run
*.tsbuildinfo
